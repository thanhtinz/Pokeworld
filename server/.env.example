# PokeWorld server — copy thành .env rồi sửa giá trị
PORT=8790
# Chuỗi bí mật ký JWT — BẮT BUỘC đổi khi chạy thật (chuỗi ngẫu nhiên dài)
JWT_SECRET=change-this-to-a-long-random-string
# Tài khoản admin (đăng nhập trang /admin)
ADMIN_USER=admin
ADMIN_PASS=changeme
# Thư mục chứa database (mount volume khi chạy docker)
DATA_DIR=./data
